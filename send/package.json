{
  "name": "northstar-dashboards",
  "private": true,
  "description": "Fireworks x Northstar Retail Group — internal QBR and customer account-health dashboards",
  "workspaces": [
    "shared",
    "internal-qbr",
    "customer-health"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:internal": "npm run dev -w internal-qbr",
    "dev:customer": "npm run dev -w customer-health",
    "build": "npm run build -w internal-qbr && npm run build -w customer-health",
    "preview:internal": "npm run preview -w internal-qbr",
    "preview:customer": "npm run preview -w customer-health",
    "test": "vitest run",
    "typecheck": "tsc -p internal-qbr --noEmit && tsc -p customer-health --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
